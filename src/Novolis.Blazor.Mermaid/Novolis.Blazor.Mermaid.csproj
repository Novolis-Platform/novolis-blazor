<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>Novolis.Blazor.Mermaid</PackageId>
    <RootNamespace>Novolis.Blazor.Mermaid</RootNamespace>
    <Description>Blazor Mermaid component backed by Novolis markup and headless rendering.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <LibraryReference Include="Novolis.Markup.Mermaid" />
    <LibraryReference Include="Novolis.Markup.Mermaid.Rendering" />
  </ItemGroup>
</Project>
